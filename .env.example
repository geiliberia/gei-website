# Public URL of the live site (used for canonical links, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://example.org

# Contact form delivery (Resend, https://resend.com). Without these the form
# returns a "temporarily unavailable" message in production instead of dropping messages.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
